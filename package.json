{
  "name": "@zalib/back",
  "version": "11.1.6",
  "description": "Platform backend package",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.22.3",
    "npm": "^10.9.8"
  },
  "files": [
    "dist/**/*"
  ],
  "exports": {
    "./bootstrap": {
      "default": "./dist/bootstrap/index.js",
      "types": "./dist/bootstrap/index.d.ts"
    },
    "./config": {
      "default": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./helpers": {
      "default": "./dist/helpers/index.js",
      "types": "./dist/helpers/index.d.ts"
    },
    "./logger": {
      "default": "./dist/logger/index.js",
      "types": "./dist/logger/index.d.ts"
    },
    "./request": {
      "default": "./dist/request/index.js",
      "types": "./dist/request/index.d.ts"
    },
    "./typebox": {
      "default": "./dist/typebox/index.js",
      "types": "./dist/typebox/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsp-repo/back.git"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "format": "prettier --write 'src/**/*.{js,ts,json,md}'",
    "lint": "eslint ./src --quiet",
    "lint:fix": "eslint ./src --fix",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint",
    "release:major": "npm version major",
    "release:minor": "npm version minor",
    "release:patch": "npm version patch",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/static": "9.1.3",
    "@nestjs/common": "11.1.24",
    "@nestjs/core": "11.1.24",
    "@nestjs/microservices": "11.1.24",
    "@nestjs/platform-fastify": "11.1.24",
    "@nestjs/swagger": "11.4.4",
    "@nestjs/websockets": "11.1.24",
    "@zalib/core": "^5.9.21",
    "fastify": "5.8.5",
    "nestjs-pino": "4.6.1",
    "qs": "6.15.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.25",
    "@types/qs": "6.15.1",
    "@zalib/devkit": "^5.9.8"
  },
  "lint-staged": {
    "package.json": "check-exact-package",
    "*.{js,ts}": [
      "eslint --quiet --max-warnings 0",
      "eslint --quiet --fix",
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged --allow-empty"
    }
  }
}
